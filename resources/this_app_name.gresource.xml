<?xml version="1.0" encoding="UTF-8"?>
<gresources>
    <gresource prefix="/resource_path">
        <!-- GtkBuilder resource files using *.glade to differentiate from composite templates -->
        <file alias="main_app_wnd" compressed="true"
              preprocess="xml-stripblanks">resources/this_app_name.glade</file>
        <file alias="hw_sim_panel" compressed="true"
              preprocess="xml-stripblanks">resources/hw_sim_panel.glade</file>

        <!-- Composite Templates using *.ui to differentiate from "builder" templates -->
        <file alias="validated_entry" compressed="true"
              preprocess="xml-stripblanks">resources/composite_templates/validated_entry.ui</file>
        <file alias="mode_prompt" compressed="true"
              preprocess="xml-stripblanks">resources/composite_templates/mode_prompt.ui</file>
        <file alias="log_terminal" compressed="true"
              preprocess="xml-stripblanks">resources/composite_templates/log_terminal.ui</file>
        <file alias="app_mode_selector" compressed="true"
              preprocess="xml-stripblanks">resources/composite_templates/app_mode_selector.ui</file>
        <file alias="standard_context" compressed="true"
              preprocess="xml-stripblanks">resources/composite_templates/standard_context.ui</file>
        <file alias="service_context" compressed="true"
              preprocess="xml-stripblanks">resources/composite_templates/service_context.ui</file>

        <!-- CSS -->
        <file>resources/style/this_app_name_style.css</file>
    </gresource>
</gresources>